{
  "name": "youtube-ai",
  "displayName": "Youtube AI",
  "version": "0.0.1",
  "description": "A chrome extension that lets you chat with youtube videos",
  "author": "Paolo Nessim",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "dev:extension": "plasmo dev",
    "build:extension": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.6.2",
    "@plasmohq/redux-persist": "^6.1.0",
    "@plasmohq/storage": "^1.15.0",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^2.20.3",
    "openai": "^4.104.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hotkeys-hook": "^4.6.2",
    "react-intersection-observer": "^9.16.0",
    "react-markdown": "^9.1.0",
    "react-textarea-autosize": "^8.5.9",
    "redux-persist-webextension-storage": "^1.0.2",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.2",
    "path-browserify": "^1.0.1",
    "postcss": "^8.5.32",
    "prettier": "3.2.4",
    "process": "^0.11.10",
    "tailwindcss": "^3.4.19",
    "typescript": "5.3.3",
    "url": "^0.11.4",
    "vite": "8.2.4",
    "vitest": "^5.0.5"
  },
  "manifest": {
    "key": "$CRX_KEY",
    "host_permissions": [
      "https://*/*"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "options.html"
        ],
        "matches": [
          "<all_urls>"
        ],
        "extension_ids": [
          "$CRX_ID"
        ]
      }
    ]
  },
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "pnpm@12.6.0"
}
